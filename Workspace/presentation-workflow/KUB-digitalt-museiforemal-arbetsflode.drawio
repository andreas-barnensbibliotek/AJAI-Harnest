        <object id="b1" label="&lt;b&gt;B1 • Lagra AIP under åtkomstskydd&lt;/b&gt;&lt;br&gt;Skydda original och paket mot obehörig ändring.&lt;br&gt;Knyt bevarande-ID, version, plats och åtkomstpolicy." tooltip="B1 • Lagra AIP under åtkomstskydd | Skydda original och paket mot obehörig ändring. | Knyt bevarande-ID, version, plats och åtkomstpolicy.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#0F172A;fontFamily=Helvetica;fontSize=19;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
