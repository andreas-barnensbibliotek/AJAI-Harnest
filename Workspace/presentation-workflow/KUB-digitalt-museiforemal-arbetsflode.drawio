        </object>
        <mxCell id="e-s5-s5-exception" value="Nej" edge="1" parent="1" source="s5" target="s5-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="note0" label="&lt;b&gt;LIDO / Dublin Core / CIDOC CRM • vid export&lt;/b&gt;&lt;br&gt;&lt;b&gt;LIDO:&lt;/b&gt; XML-baserat musealt informationsutbyte.&lt;br&gt;&lt;b&gt;Dublin Core:&lt;/b&gt; generell, förenklad beskrivning och sökning.&lt;br&gt;&lt;b&gt;CIDOC CRM:&lt;/b&gt; semantisk mappning av relationer.&lt;br&gt;De är inte tre obligatoriska parallella filformat." tooltip="LIDO / Dublin Core / CIDOC CRM • vid export | &lt;b&gt;LIDO:&lt;/b&gt; XML-baserat musealt informationsutbyte. | &lt;b&gt;Dublin Core:&lt;/b&gt; generell, förenklad beskrivning och sökning. | &lt;b&gt;CIDOC CRM:&lt;/b&gt; semantisk mappning av relationer. | De är inte tre obligatoriska parallella filformat.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="180" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note1" label="&lt;b&gt;OAIS • SIP är leveranspaketets roll&lt;/b&gt;&lt;br&gt;SIP = Submission Information Package.&lt;br&gt;Exempel: data/master.tif; metadata/beskrivning.xml,&lt;br&gt;teknik.xml, rättigheter.xml; manifest/checksums.txt.&lt;br&gt;OAIS föreskriver inte just dessa mappnamn eller att beskrivningen måste vara Dublin Core." tooltip="OAIS • SIP är leveranspaketets roll | SIP = Submission Information Package. | Exempel: data/master.tif; metadata/beskrivning.xml, | teknik.xml, rättigheter.xml; manifest/checksums.txt. | OAIS föreskriver inte just dessa mappnamn eller att beskrivningen måste vara Dublin Core.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="410" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note2" label="&lt;b&gt;E-ARK / VGR • villkorad lokal tillämpning&lt;/b&gt;&lt;br&gt;Exempelritningen nämner VGR:s tillämpning av E-ARK&lt;br&gt;CSIP, SIP, AIP och DIP, version 3.0.&lt;br&gt;&lt;b&gt;Själva specifikationen saknas i underlagen.&lt;/b&gt;&lt;br&gt;Bekräfta gällande profil och scheman; exempelpaketet är inte en verifierad E-ARK-konform leverans." tooltip="E-ARK / VGR • villkorad lokal tillämpning | Exempelritningen nämner VGR:s tillämpning av E-ARK | CSIP, SIP, AIP och DIP, version 3.0. | &lt;b&gt;Själva specifikationen saknas i underlagen.&lt;/b&gt; | Bekräfta gällande profil och scheman; exempelpaketet är inte en verifierad E-ARK-konform leverans.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="640" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note3" label="&lt;b&gt;SHA-256 • när filernas integritet förseglas&lt;/b&gt;&lt;br&gt;SHA-256 är en hashfunktion specificerad i FIPS 180-4.&lt;br&gt;Manifestet binder varje filreferens till dess kontrollsumma.&lt;br&gt;Hashen upptäcker ändrade byte, inte felaktigt motiv eller rättighet.&lt;br&gt;Python-paketerare i exemplet är ett verktygsförslag." tooltip="SHA-256 • när filernas integritet förseglas | SHA-256 är en hashfunktion specificerad i FIPS 180-4. | Manifestet binder varje filreferens till dess kontrollsumma. | Hashen upptäcker ändrade byte, inte felaktigt motiv eller rättighet. | Python-paketerare i exemplet är ett verktygsförslag.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="870" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
