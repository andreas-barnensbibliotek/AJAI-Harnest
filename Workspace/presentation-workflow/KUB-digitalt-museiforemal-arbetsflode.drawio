        <mxCell id="e-b4-b5" value="Ja" edge="1" parent="1" source="b4" target="b5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#475569;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="b6" label="&lt;b&gt;B6 • Fortsätt bevarandecykeln&lt;/b&gt;&lt;br&gt;Logga kontrollresultat; nästa körning återgår till B3.&lt;br&gt;AIP tillgängligt för DIP → 07; metadataändring → 08." tooltip="B6 • Fortsätt bevarandecykeln | Logga kontrollresultat; nästa körning återgår till B3. | AIP tillgängligt för DIP → 07; metadataändring → 08." link="data:page/id,p07">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#0F172A;fontFamily=Helvetica;fontSize=19;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="480" y="955" width="460" height="115" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e-b5-b6" value="Nej" edge="1" parent="1" source="b5" target="b6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#475569;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="b4-exception" label="&lt;b&gt;Integritetsincident&lt;/b&gt;&lt;br&gt;Larma; isolera felaktig kopia. Återställ från verifierad kopia och logga åtgärden.&lt;br&gt;Åter till B3/B4. Byt inte referenshash för att dölja felet." tooltip="Integritetsincident | Larma; isolera felaktig kopia. Återställ från verifierad kopia och logga åtgärden. | Åter till B3/B4. Byt inte referenshash för att dölja felet." link="data:page/id,p06">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="645" width="360" height="130" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e-b4-b4-exception" value="Nej" edge="1" parent="1" source="b4" target="b4-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="b5-exception" label="&lt;b&gt;Kontrollerad formatmigrering&lt;/b&gt;&lt;br&gt;Gemensamt beslut; skapa ny representation och validera.&lt;br&gt;Bevara original och åtgärdshistorik enligt policy.&lt;br&gt;Åter till B1/B3 med versionsspår." tooltip="Kontrollerad formatmigrering | Gemensamt beslut; skapa ny representation och validera. | Bevara original och åtgärdshistorik enligt policy. | Åter till B1/B3 med versionsspår." link="data:page/id,p06">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="800" width="360" height="130" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e-b5-b5-exception" value="Ja" edge="1" parent="1" source="b5" target="b5-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="note0" label="&lt;b&gt;OAIS • aktiv bevarandeprocess&lt;/b&gt;&lt;br&gt;AIP förvaltas över tid, inte enbart vid den första leveransen.&lt;br&gt;Integritetskontroll, dokumenterade åtgärder och planering för läsbarhet ingår i kedjan.&lt;br&gt;SHA-256 används vid återkommande bytekontroll." tooltip="OAIS • aktiv bevarandeprocess | AIP förvaltas över tid, inte enbart vid den första leveransen. | Integritetskontroll, dokumenterade åtgärder och planering för läsbarhet ingår i kedjan. | SHA-256 används vid återkommande bytekontroll.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="180" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note1" label="&lt;b&gt;Arkitektur i exempelritningen • ej verifierad drift&lt;/b&gt;&lt;br&gt;Powerscale i DC1/DC2/DC3, Cohesity samt separat offsite/air-gap förekommer i ritningen.&lt;br&gt;Behandla detta som arkitekturunderlag, inte bekräftad installation.&lt;br&gt;KSD måste besluta placering, säkerhet, antal kopior och återläsningstester." tooltip="Arkitektur i exempelritningen • ej verifierad drift | Powerscale i DC1/DC2/DC3, Cohesity samt separat offsite/air-gap förekommer i ritningen. | Behandla detta som arkitekturunderlag, inte bekräftad installation. | KSD måste besluta placering, säkerhet, antal kopior och återläsningstester.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="410" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note2" label="&lt;b&gt;Dubbletter ≠ skyddskopior&lt;/b&gt;&lt;br&gt;Ritningens idé om att lagra original/paket en gång bör läsas som undvikna oavsiktliga dubbelleveranser.&lt;br&gt;Den får &lt;b&gt;inte&lt;/b&gt; avskaffa redundans, backup eller versionshistorik.&lt;br&gt;Fastställ hantering av återleverans och avsiktlig ny version." tooltip="Dubbletter ≠ skyddskopior | Ritningens idé om att lagra original/paket en gång bör läsas som undvikna oavsiktliga dubbelleveranser. | Den får &lt;b&gt;inte&lt;/b&gt; avskaffa redundans, backup eller versionshistorik. | Fastställ hantering av återleverans och avsiktlig ny version.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="640" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note3" label="&lt;b&gt;Lokala beslut som återstår&lt;/b&gt;&lt;br&gt;Kontrollintervall, återställningsmål, behörigheter,&lt;br&gt;larmkedja, lagringstid och migreringskriterier.&lt;br&gt;Ingen automatisk gallring härleds ur exempelritningens pluginlista.&lt;br&gt;Museet beslutar innehåll; IT verkställer inte egna värderingar." tooltip="Lokala beslut som återstår | Kontrollintervall, återställningsmål, behörigheter, | larmkedja, lagringstid och migreringskriterier. | Ingen automatisk gallring härleds ur exempelritningens pluginlista. | Museet beslutar innehåll; IT verkställer inte egna värderingar.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="870" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
