        <object id="s5-exception" label="&lt;b&gt;Rätta paket eller mappning&lt;/b&gt;&lt;br&gt;Rapportera vilket krav som inte uppfylls.&lt;br&gt;Åter till S1–S4 efter ansvar; kör S5 igen.&lt;br&gt;Kontrollsummor räknas om vid legitim ändring." tooltip="Rätta paket eller mappning | Rapportera vilket krav som inte uppfylls. | Åter till S1–S4 efter ansvar; kör S5 igen. | Kontrollsummor räknas om vid legitim ändring." link="data:page/id,p04">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
