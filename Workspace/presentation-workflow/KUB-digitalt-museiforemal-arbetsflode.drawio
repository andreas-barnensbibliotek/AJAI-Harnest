        </object>
        <object id="ref2" label="&lt;b&gt;LIDO / Dublin Core • informationsutbyte&lt;/b&gt;&lt;br&gt;&lt;b&gt;När:&lt;/b&gt; export till bevarande eller mottagande tjänst (04, 07, 08).&lt;br&gt;&lt;b&gt;Ägare:&lt;/b&gt; informations-/systemförvaltning.&lt;br&gt;&lt;b&gt;Notera:&lt;/b&gt; LIDO är XML; Dublin Core är metadatatermer med vald serialisering. Behåll rik källdata." tooltip="LIDO / Dublin Core • informationsutbyte | &lt;b&gt;När:&lt;/b&gt; export till bevarande eller mottagande tjänst (04, 07, 08). | &lt;b&gt;Ägare:&lt;/b&gt; informations-/systemförvaltning. | &lt;b&gt;Notera:&lt;/b&gt; LIDO är XML; Dublin Core är metadatatermer med vald serialisering. Behåll rik källdata.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="395" width="840" height="210" as="geometry" />
          </mxCell>
        </object>
        <object id="ref3" label="&lt;b&gt;OAIS • referensmodell för bevarande&lt;/b&gt;&lt;br&gt;&lt;b&gt;När:&lt;/b&gt; SIP vid leverans (04), AIP efter ingest och under bevarande (05–06), DIP vid utlämning (07).&lt;br&gt;&lt;b&gt;Ägare:&lt;/b&gt; bevarandefunktion + teknisk lösning.&lt;br&gt;&lt;b&gt;Inte:&lt;/b&gt; en bestämd filkatalog eller certifiering av RODA." tooltip="OAIS • referensmodell för bevarande | &lt;b&gt;När:&lt;/b&gt; SIP vid leverans (04), AIP efter ingest och under bevarande (05–06), DIP vid utlämning (07). | &lt;b&gt;Ägare:&lt;/b&gt; bevarandefunktion + teknisk lösning. | &lt;b&gt;Inte:&lt;/b&gt; en bestämd filkatalog eller certifiering av RODA.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="920" y="395" width="840" height="210" as="geometry" />
          </mxCell>
        </object>
        <object id="ref4" label="&lt;b&gt;SHA-256 • FIPS 180-4&lt;/b&gt;&lt;br&gt;&lt;b&gt;När:&lt;/b&gt; manifest skapas, överföring verifieras och integritet följs upp (04–06).&lt;br&gt;&lt;b&gt;Ägare:&lt;/b&gt; IT/KSD + bevarandefunktionen.&lt;br&gt;&lt;b&gt;Inte:&lt;/b&gt; bevis för korrekt motiv, rättighet eller fullständig bevarandeprocess." tooltip="SHA-256 • FIPS 180-4 | &lt;b&gt;När:&lt;/b&gt; manifest skapas, överföring verifieras och integritet följs upp (04–06). | &lt;b&gt;Ägare:&lt;/b&gt; IT/KSD + bevarandefunktionen. | &lt;b&gt;Inte:&lt;/b&gt; bevis för korrekt motiv, rättighet eller fullständig bevarandeprocess.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="630" width="840" height="210" as="geometry" />
          </mxCell>
        </object>
        <object id="ref5" label="&lt;b&gt;E-ARK CSIP/SIP/AIP/DIP • villkorad profil&lt;/b&gt;&lt;br&gt;&lt;b&gt;När:&lt;/b&gt; om beslutade leverans-/bevaranderegler kräver det (04–05).&lt;br&gt;&lt;b&gt;Källa:&lt;/b&gt; exempelritningen nämner VGR-tillämpning v3.0.&lt;br&gt;&lt;b&gt;Återstår:&lt;/b&gt; skaffa specifikationen, bekräfta version och validera mot rätt scheman. Konformitet är inte verifierad." tooltip="E-ARK CSIP/SIP/AIP/DIP • villkorad profil | &lt;b&gt;När:&lt;/b&gt; om beslutade leverans-/bevaranderegler kräver det (04–05). | &lt;b&gt;Källa:&lt;/b&gt; exempelritningen nämner VGR-tillämpning v3.0. | &lt;b&gt;Återstår:&lt;/b&gt; skaffa specifikationen, bekräfta version och validera mot rätt scheman. Konformitet är inte verifierad.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="920" y="630" width="840" height="210" as="geometry" />
          </mxCell>
        </object>
        <object id="ref6" label="&lt;b&gt;Överlämningar • vad varje part måste få&lt;/b&gt;&lt;br&gt;&lt;b&gt;Museet → informationsförvaltning:&lt;/b&gt; master, ID, rik metadata, källor och bevarandebeslut.&lt;br&gt;&lt;b&gt;Informationsförvaltning → bevarande:&lt;/b&gt; verifierad profil/mappning och spårbart SIP.&lt;br&gt;&lt;b&gt;Bevarande → museet:&lt;/b&gt; kvittens/felrapport, AIP-ID och version." tooltip="Överlämningar • vad varje part måste få | &lt;b&gt;Museet → informationsförvaltning:&lt;/b&gt; master, ID, rik metadata, källor och bevarandebeslut. | &lt;b&gt;Informationsförvaltning → bevarande:&lt;/b&gt; verifierad profil/mappning och spårbart SIP. | &lt;b&gt;Bevarande → museet:&lt;/b&gt; kvittens/felrapport, AIP-ID och version.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="865" width="840" height="210" as="geometry" />
          </mxCell>
        </object>
        <object id="ref7" label="&lt;b&gt;Gemensamma beslut före produktionssättning&lt;/b&gt;&lt;br&gt;Informationsprofil och fältkrav; format och validering; behörigheter; överförings-/ändringsrutiner; gallringsbeslut; antal kopior; kontrollintervall; larm/återställning; migreringskriterier och publiceringsvillkor.&lt;br&gt;&lt;b&gt;IT/KSD säkrar tekniken – museet beslutar om innehåll.&lt;/b&gt;" tooltip="Gemensamma beslut före produktionssättning | Informationsprofil och fältkrav; format och validering; behörigheter; överförings-/ändringsrutiner; gallringsbeslut; antal kopior; kontrollintervall; larm/återställning; migreringskriterier och publiceringsvillkor. | &lt;b&gt;IT/KSD säkrar tekniken – museet beslutar om innehåll.&lt;/b&gt;">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
