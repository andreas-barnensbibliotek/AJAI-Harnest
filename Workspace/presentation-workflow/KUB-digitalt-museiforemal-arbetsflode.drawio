        <object id="b5" label="&lt;b&gt;B5 • Behövs formatmigrering?&lt;/b&gt;&lt;br&gt;Har formatbevakning identifierat&lt;br&gt;risk för framtida läsbarhet?" tooltip="B5 • Behövs formatmigrering? | Har formatbevakning identifierat | risk för framtida läsbarhet?">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#0F172A;fontFamily=Helvetica;fontSize=19;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;shape=rhombus;rounded=0;align=center;spacing=4;fontSize=18;">
