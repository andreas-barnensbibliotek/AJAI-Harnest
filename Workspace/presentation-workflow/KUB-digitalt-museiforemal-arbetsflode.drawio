        <object id="q4-exception" label="&lt;b&gt;Korrigera utan att skriva över master&lt;/b&gt;&lt;br&gt;Utred skada eller felkoppling, rätta metadata eller begär ny leverans.&lt;br&gt;Åter till Q1/Q3 och kontrollera Q4 igen." tooltip="Korrigera utan att skriva över master | Utred skada eller felkoppling, rätta metadata eller begär ny leverans. | Åter till Q1/Q3 och kontrollera Q4 igen." link="data:page/id,p03">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="645" width="360" height="130" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e-q4-q4-exception" value="Nej" edge="1" parent="1" source="q4" target="q4-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="q5-exception" label="&lt;b&gt;Spärra överlämning till bevarande&lt;/b&gt;&lt;br&gt;Museet utreder bevaranderätten och dokumenterar beslut.&lt;br&gt;Åter till Q5 efter klartecken; ingen automatisk accept." tooltip="Spärra överlämning till bevarande | Museet utreder bevaranderätten och dokumenterar beslut. | Åter till Q5 efter klartecken; ingen automatisk accept." link="data:page/id,p03">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="800" width="360" height="130" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e-q5-q5-exception" value="Nej" edge="1" parent="1" source="q5" target="q5-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="note0" label="&lt;b&gt;Spectrum • Cataloguing / Rights management&lt;/b&gt;&lt;br&gt;Kvalitetssäkra att fil och kataloginformation hör ihop.&lt;br&gt;Dokumentera rättighetsinnehavare, källor och villkor.&lt;br&gt;Bevaranderätt och publiceringsrätt prövas separat;&lt;br&gt;saknad publiceringsrätt hindrar inte tillåtet bevarande." tooltip="Spectrum • Cataloguing / Rights management | Kvalitetssäkra att fil och kataloginformation hör ihop. | Dokumentera rättighetsinnehavare, källor och villkor. | Bevaranderätt och publiceringsrätt prövas separat; | saknad publiceringsrätt hindrar inte tillåtet bevarande.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="180" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note1" label="&lt;b&gt;Lokal filrutin • inte en egen museistandard&lt;/b&gt;&lt;br&gt;&lt;b&gt;original/&lt;/b&gt; ULRI-FOTO-00125_master.tif&lt;br&gt;&lt;b&gt;working/&lt;/b&gt; ULRI-FOTO-00125_edit.tif&lt;br&gt;&lt;b&gt;access/&lt;/b&gt; ULRI-FOTO-00125_web.jpg&lt;br&gt;&lt;b&gt;metadata/&lt;/b&gt; beskrivning och tekniska uppgifter&lt;br&gt;TIFF/JPEG är exempel, inte generella formatkrav." tooltip="Lokal filrutin • inte en egen museistandard | &lt;b&gt;original/&lt;/b&gt; ULRI-FOTO-00125_master.tif | &lt;b&gt;working/&lt;/b&gt; ULRI-FOTO-00125_edit.tif | &lt;b&gt;access/&lt;/b&gt; ULRI-FOTO-00125_web.jpg | &lt;b&gt;metadata/&lt;/b&gt; beskrivning och tekniska uppgifter | TIFF/JPEG är exempel, inte generella formatkrav.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="410" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note2" label="&lt;b&gt;Teknisk metadata ≠ museal beskrivning&lt;/b&gt;&lt;br&gt;Filformat och bitdjup beskriver den digitala representationen.&lt;br&gt;Motiv, fotograf, plats och proveniens beskriver museiobjektet.&lt;br&gt;Behåll koppling mellan nivåerna; filnamnet är inte hela identifieringen." tooltip="Teknisk metadata ≠ museal beskrivning | Filformat och bitdjup beskriver den digitala representationen. | Motiv, fotograf, plats och proveniens beskriver museiobjektet. | Behåll koppling mellan nivåerna; filnamnet är inte hela identifieringen.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="640" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note3" label="&lt;b&gt;Utdata • verifierbar kvalitetsgrind&lt;/b&gt;&lt;br&gt;Dokumenterat kontrollresultat och bevarandebeslut.&lt;br&gt;Ej utredda publiceringsvillkor följer med som begränsning.&lt;br&gt;Original används aldrig som arbetsfil.&lt;br&gt;Metod, formatkrav och toleranser beslutas lokalt." tooltip="Utdata • verifierbar kvalitetsgrind | Dokumenterat kontrollresultat och bevarandebeslut. | Ej utredda publiceringsvillkor följer med som begränsning. | Original används aldrig som arbetsfil. | Metod, formatkrav och toleranser beslutas lokalt.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="870" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
