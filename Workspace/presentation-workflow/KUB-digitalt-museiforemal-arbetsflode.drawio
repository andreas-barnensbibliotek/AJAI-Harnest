        <mxCell id="e-d4-d5" value="Ja" edge="1" parent="1" source="d4" target="d5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#475569;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="d6" label="&lt;b&gt;D6 • Dokumentera användning och status&lt;/b&gt;&lt;br&gt;Registrera DIP-/AIP-referens, version, kanal, datum&lt;br&gt;och beslut. Fortsatt rättighetsuppföljning → sida 08." tooltip="D6 • Dokumentera användning och status | Registrera DIP-/AIP-referens, version, kanal, datum | och beslut. Fortsatt rättighetsuppföljning → sida 08." link="data:page/id,p08">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#0F172A;fontFamily=Helvetica;fontSize=19;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="480" y="955" width="460" height="115" as="geometry" />
