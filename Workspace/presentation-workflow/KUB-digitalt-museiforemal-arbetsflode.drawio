          </mxCell>
        </object>
        <mxCell id="e-r4-r4-exception" value="Nej" edge="1" parent="1" source="r4" target="r4-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="note0" label="&lt;b&gt;OAIS • från SIP till AIP&lt;/b&gt;&lt;br&gt;&lt;b&gt;SIP:&lt;/b&gt; avsändarens leveranspaket.&lt;br&gt;&lt;b&gt;AIP:&lt;/b&gt; Archival Information Package, arkivets bevarandepaket.&lt;br&gt;Bevara innehåll, representation/sammanhang och spårbarhet.&lt;br&gt;AIP är inte bara en omdöpt TIFF-fil eller backup." tooltip="OAIS • från SIP till AIP | &lt;b&gt;SIP:&lt;/b&gt; avsändarens leveranspaket. | &lt;b&gt;AIP:&lt;/b&gt; Archival Information Package, arkivets bevarandepaket. | Bevara innehåll, representation/sammanhang och spårbarhet. | AIP är inte bara en omdöpt TIFF-fil eller backup.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="180" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note1" label="&lt;b&gt;RODA • system och konfigurerade funktioner&lt;/b&gt;&lt;br&gt;Mottagning, validering, paketregistrering och bevarande.&lt;br&gt;Exempelritningen listar formatdetektor, metadata- och malwarekontroll, behörighet och automatisk accept.&lt;br&gt;&lt;b&gt;Verifiera installerad version, pluginstöd och policy.&lt;/b&gt;&lt;br&gt;Automatisk accept är inte ett generellt krav." tooltip="RODA • system och konfigurerade funktioner | Mottagning, validering, paketregistrering och bevarande. | Exempelritningen listar formatdetektor, metadata- och malwarekontroll, behörighet och automatisk accept. | &lt;b&gt;Verifiera installerad version, pluginstöd och policy.&lt;/b&gt; | Automatisk accept är inte ett generellt krav.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="410" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note2" label="&lt;b&gt;Paketprofil och teknisk integritet&lt;/b&gt;&lt;br&gt;Om E-ARK/VGR väljs ska dess beslutade version valideras.&lt;br&gt;Jämför mottagna kontrollsummor med SIP-manifestet;&lt;br&gt;registrera AIP:s egna integritetsuppgifter och historik.&lt;br&gt;Bevara rapporter även när leveransen avvisas." tooltip="Paketprofil och teknisk integritet | Om E-ARK/VGR väljs ska dess beslutade version valideras. | Jämför mottagna kontrollsummor med SIP-manifestet; | registrera AIP:s egna integritetsuppgifter och historik. | Bevara rapporter även när leveransen avvisas.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="640" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note3" label="&lt;b&gt;Ingestkvittens • tydlig systemgräns&lt;/b&gt;&lt;br&gt;Skilj mottagen, validerad, accepterad och lagrad status.&lt;br&gt;Registrera kopplingen Primus-ID ↔ leverans-ID ↔ AIP-ID/version.&lt;br&gt;Ingen automatisk Primus-integration antas.&lt;br&gt;Fastställ vem som kvitterar och hur status återförs." tooltip="Ingestkvittens • tydlig systemgräns | Skilj mottagen, validerad, accepterad och lagrad status. | Registrera kopplingen Primus-ID ↔ leverans-ID ↔ AIP-ID/version. | Ingen automatisk Primus-integration antas. | Fastställ vem som kvitterar och hur status återförs.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="870" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
