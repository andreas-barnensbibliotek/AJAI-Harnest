        <object id="ref0" label="&lt;b&gt;Spectrum • arbetsprocess&lt;/b&gt;&lt;br&gt;&lt;b&gt;När:&lt;/b&gt; mottagning, förvärv vid behov, katalogisering, rättigheter och fortsatt förvaltning (02, 03, 07, 08).&lt;br&gt;&lt;b&gt;Ägare:&lt;/b&gt; museiverksamheten/samlingsförvaltningen.&lt;br&gt;&lt;b&gt;Inte:&lt;/b&gt; metadataformat eller lagringsprodukt." tooltip="Spectrum • arbetsprocess | &lt;b&gt;När:&lt;/b&gt; mottagning, förvärv vid behov, katalogisering, rättigheter och fortsatt förvaltning (02, 03, 07, 08). | &lt;b&gt;Ägare:&lt;/b&gt; museiverksamheten/samlingsförvaltningen. | &lt;b&gt;Inte:&lt;/b&gt; metadataformat eller lagringsprodukt.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
