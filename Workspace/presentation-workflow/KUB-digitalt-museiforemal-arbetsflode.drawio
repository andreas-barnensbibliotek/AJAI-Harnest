        <mxCell id="e-b3-b4" value="" edge="1" parent="1" source="b3" target="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#475569;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
