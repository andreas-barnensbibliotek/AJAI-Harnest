        <object id="ref1" label="&lt;b&gt;CIDOC CRM • begreppsmodell / ontologi&lt;/b&gt;&lt;br&gt;&lt;b&gt;När:&lt;/b&gt; relationer och semantisk mappning (02, 04, 08).&lt;br&gt;&lt;b&gt;Ägare:&lt;/b&gt; informationsmodellering + systemförvaltning.&lt;br&gt;&lt;b&gt;Inte:&lt;/b&gt; påstående om Primus interna databas eller färdig implementerad CRM-export." tooltip="CIDOC CRM • begreppsmodell / ontologi | &lt;b&gt;När:&lt;/b&gt; relationer och semantisk mappning (02, 04, 08). | &lt;b&gt;Ägare:&lt;/b&gt; informationsmodellering + systemförvaltning. | &lt;b&gt;Inte:&lt;/b&gt; påstående om Primus interna databas eller färdig implementerad CRM-export.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="920" y="160" width="840" height="210" as="geometry" />
