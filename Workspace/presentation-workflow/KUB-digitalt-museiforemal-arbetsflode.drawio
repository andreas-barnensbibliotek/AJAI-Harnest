        <mxCell id="e-m5-m5-exception" value="Nej" edge="1" parent="1" source="m5" target="m5-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="note0" label="&lt;b&gt;Spectrum • när bilden tas emot och beskrivs&lt;/b&gt;&lt;br&gt;&lt;b&gt;Object entry:&lt;/b&gt; dokumentera mottagning och ansvar.&lt;br&gt;&lt;b&gt;Acquisition:&lt;/b&gt; när förvärv är tillämpligt; mottagning är inte automatiskt förvärv.&lt;br&gt;&lt;b&gt;Cataloguing:&lt;/b&gt; kvalitet och spårbar kataloginformation." tooltip="Spectrum • när bilden tas emot och beskrivs | &lt;b&gt;Object entry:&lt;/b&gt; dokumentera mottagning och ansvar. | &lt;b&gt;Acquisition:&lt;/b&gt; när förvärv är tillämpligt; mottagning är inte automatiskt förvärv. | &lt;b&gt;Cataloguing:&lt;/b&gt; kvalitet och spårbar kataloginformation.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="180" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note1" label="&lt;b&gt;CIDOC CRM • när relationer modelleras&lt;/b&gt;&lt;br&gt;Beskriv sambanden: bild – avbildad byggnad – plats;&lt;br&gt;fotografering – aktör – tid; objekt – proveniens.&lt;br&gt;Gemensam semantisk förståelse, inte krav på att Primus lagrar CRM internt.&lt;br&gt;Klasser, relationer och version fastställs i en lokal mappning." tooltip="CIDOC CRM • när relationer modelleras | Beskriv sambanden: bild – avbildad byggnad – plats; | fotografering – aktör – tid; objekt – proveniens. | Gemensam semantisk förståelse, inte krav på att Primus lagrar CRM internt. | Klasser, relationer och version fastställs i en lokal mappning.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="410" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note2" label="&lt;b&gt;Exemplet är inte en verifierad museipost&lt;/b&gt;&lt;br&gt;Underlaget använder posthus i Ulricehamn, cirka 1920,&lt;br&gt;men den inledande bildhänvisningen nämner Bohusläns museum och andra gator.&lt;br&gt;Bekräfta ort, motiv och bildkälla före skarp registrering.&lt;br&gt;Okänd fotograf ska inte ersättas med en gissning." tooltip="Exemplet är inte en verifierad museipost | Underlaget använder posthus i Ulricehamn, cirka 1920, | men den inledande bildhänvisningen nämner Bohusläns museum och andra gator. | Bekräfta ort, motiv och bildkälla före skarp registrering. | Okänd fotograf ska inte ersättas med en gissning.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="640" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note3" label="&lt;b&gt;Utdata och överlämning&lt;/b&gt;&lt;br&gt;Objekt-ID är den röda tråden mellan Primus, filer och paket.&lt;br&gt;Håll fysisk förlaga, bildens innehåll och digital fil isär.&lt;br&gt;Rättighetsstatus kan vara under utredning här; slutlig bevaranderätt prövas på sida 03." tooltip="Utdata och överlämning | Objekt-ID är den röda tråden mellan Primus, filer och paket. | Håll fysisk förlaga, bildens innehåll och digital fil isär. | Rättighetsstatus kan vara under utredning här; slutlig bevaranderätt prövas på sida 03.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="870" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
