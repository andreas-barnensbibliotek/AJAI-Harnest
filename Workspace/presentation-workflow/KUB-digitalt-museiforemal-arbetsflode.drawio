          </mxCell>
        </object>
        <object id="b2" label="&lt;b&gt;B2 • Upprätthåll oberoende skyddskopior&lt;/b&gt;&lt;br&gt;Separat lagringsplats + säkerhetskopior enligt beslutad policy.&lt;br&gt;Kontrollera redundans och att återläsning fungerar." tooltip="B2 • Upprätthåll oberoende skyddskopior | Separat lagringsplats + säkerhetskopior enligt beslutad policy. | Kontrollera redundans och att återläsning fungerar.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#0F172A;fontFamily=Helvetica;fontSize=19;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
