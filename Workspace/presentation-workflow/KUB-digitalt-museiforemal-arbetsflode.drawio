        <object id="r4-exception" label="&lt;b&gt;Avvisa / håll för granskning&lt;/b&gt;&lt;br&gt;Logga orsak, avsändare och ansvarig.&lt;br&gt;Åter till S1–S5 på sida 04 vid leveransfel; därefter ny ingest.&lt;br&gt;Ingen AIP-framgång kvitteras vid fel." tooltip="Avvisa / håll för granskning | Logga orsak, avsändare och ansvarig. | Åter till S1–S5 på sida 04 vid leveransfel; därefter ny ingest. | Ingen AIP-framgång kvitteras vid fel." link="data:page/id,p04">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
