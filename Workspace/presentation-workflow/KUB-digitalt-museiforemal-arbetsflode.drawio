        </object>
        <mxCell id="e-d5-d6" value="" edge="1" parent="1" source="d5" target="d6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#475569;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="d2-exception" label="&lt;b&gt;Avslå eller begränsa åtkomst&lt;/b&gt;&lt;br&gt;Dokumentera skäl; inget otillåtet utlämnande.&lt;br&gt;Utred annat urval/målgrupp och återgå till D1/D2.&lt;br&gt;Bevarandet påverkas inte automatiskt." tooltip="Avslå eller begränsa åtkomst | Dokumentera skäl; inget otillåtet utlämnande. | Utred annat urval/målgrupp och återgå till D1/D2. | Bevarandet påverkas inte automatiskt." link="data:page/id,p07">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="335" width="360" height="130" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e-d2-d2-exception" value="Nej" edge="1" parent="1" source="d2" target="d2-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="d4-exception" label="&lt;b&gt;Ingen offentlig publicering&lt;/b&gt;&lt;br&gt;DIP får bara lämnas till målgrupp som godkänts i D2.&lt;br&gt;Registrera begränsad åtkomst/status enligt D6.&lt;br&gt;Ny rättighet → ny prövning D1–D4." tooltip="Ingen offentlig publicering | DIP får bara lämnas till målgrupp som godkänts i D2. | Registrera begränsad åtkomst/status enligt D6. | Ny rättighet → ny prövning D1–D4." link="data:page/id,p07">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="645" width="360" height="130" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="e-d4-d4-exception" value="Nej" edge="1" parent="1" source="d4" target="d4-exception" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=16;fontColor=#334155;labelBackgroundColor=#FFFFFF;strokeColor=#B91C1C;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object id="note0" label="&lt;b&gt;OAIS • DIP är ett utlämningspaket&lt;/b&gt;&lt;br&gt;DIP = Dissemination Information Package.&lt;br&gt;Innehåll och metadata anpassas för mottagaren.&lt;br&gt;Skapad DIP innebär inte automatiskt fri webbpublicering.&lt;br&gt;Publiceringskopian ersätter aldrig master eller AIP." tooltip="OAIS • DIP är ett utlämningspaket | DIP = Dissemination Information Package. | Innehåll och metadata anpassas för mottagaren. | Skapad DIP innebär inte automatiskt fri webbpublicering. | Publiceringskopian ersätter aldrig master eller AIP.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="180" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note1" label="&lt;b&gt;Spectrum • Rights management / Use&lt;/b&gt;&lt;br&gt;Museet dokumenterar tillåtna användningar och beslut.&lt;br&gt;Pröva både framtagning/åtkomst och offentlig spridning.&lt;br&gt;En bevaranderätt ger inte i sig publiceringsrätt.&lt;br&gt;Restriktioner ska följa utlämnat material." tooltip="Spectrum • Rights management / Use | Museet dokumenterar tillåtna användningar och beslut. | Pröva både framtagning/åtkomst och offentlig spridning. | En bevaranderätt ger inte i sig publiceringsrätt. | Restriktioner ska följa utlämnat material.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="410" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note2" label="&lt;b&gt;LIDO / Dublin Core • vid leverans till kanal&lt;/b&gt;&lt;br&gt;Använd beslutad mottagarmappning för beskrivning och rättigheter.&lt;br&gt;Bekräfta kanalens faktiska tekniska profil;&lt;br&gt;LIDO är inte automatiskt rätt format för varje aggregator.&lt;br&gt;Behåll rik källdata även om kanalen tar emot färre fält." tooltip="LIDO / Dublin Core • vid leverans till kanal | Använd beslutad mottagarmappning för beskrivning och rättigheter. | Bekräfta kanalens faktiska tekniska profil; | LIDO är inte automatiskt rätt format för varje aggregator. | Behåll rik källdata även om kanalen tar emot färre fält.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="640" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note3" label="&lt;b&gt;Resultat och systemgräns&lt;/b&gt;&lt;br&gt;Åtkomstbeslut + DIP + eventuell verifierad publicering.&lt;br&gt;Publicering kan ske från särskild samlingstjänst;&lt;br&gt;någon färdig RODA–Primus–portal-koppling antas inte.&lt;br&gt;Objekt-ID och versionsreferens ger spårbarhet." tooltip="Resultat och systemgräns | Åtkomstbeslut + DIP + eventuell verifierad publicering. | Publicering kan ske från särskild samlingstjänst; | någon färdig RODA–Primus–portal-koppling antas inte. | Objekt-ID och versionsreferens ger spårbarhet.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="870" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
