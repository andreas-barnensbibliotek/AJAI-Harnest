        <object id="example" label="&lt;b&gt;Ett fotografi följer hela kedjan&lt;/b&gt;&lt;br&gt;Övnings-ID: ULRI-FOTO-00125.&lt;br&gt;Exempelmotiv: ett posthus, cirka 1920.&lt;br&gt;Ort och bildkälla måste verifieras före skarp katalogisering; se sida 02." tooltip="Ett fotografi följer hela kedjan | Övnings-ID: ULRI-FOTO-00125. | Exempelmotiv: ett posthus, cirka 1920. | Ort och bildkälla måste verifieras före skarp katalogisering; se sida 02." link="data:page/id,p02">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="180" width="360" height="230" as="geometry" />
          </mxCell>
        </object>
        <object id="reading" label="&lt;b&gt;Börja här&lt;/b&gt;&lt;br&gt;1. Läs huvudkedjan i mitten.&lt;br&gt;2. Öppna respektive detaljsida.&lt;br&gt;3. Läs standardnoteringen till höger.&lt;br&gt;4. Följ avvikelser och steg-ID tillbaka.&lt;br&gt;5. Använd flikar eller sidlänkar för navigering." tooltip="Börja här | 1. Läs huvudkedjan i mitten. | 2. Öppna respektive detaljsida. | 3. Läs standardnoteringen till höger. | 4. Följ avvikelser och steg-ID tillbaka. | 5. Använd flikar eller sidlänkar för navigering.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="450" width="360" height="230" as="geometry" />
          </mxCell>
        </object>
        <object id="followup" label="&lt;b&gt;Arbetet fortsätter efter leveransen&lt;/b&gt;&lt;br&gt;Integritet och läsbarhet kontrolleras återkommande (06).&lt;br&gt;Rättigheter prövas före publicering (07).&lt;br&gt;Ny kunskap och ändringar återförs med historik (08)." tooltip="Arbetet fortsätter efter leveransen | Integritet och läsbarhet kontrolleras återkommande (06). | Rättigheter prövas före publicering (07). | Ny kunskap och ändringar återförs med historik (08)." link="data:page/id,p08">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="40" y="720" width="360" height="230" as="geometry" />
          </mxCell>
        </object>
        <object id="note0" label="&lt;b&gt;Process ≠ modell ≠ format ≠ system&lt;/b&gt;&lt;br&gt;&lt;b&gt;Spectrum&lt;/b&gt;: arbetsprocess och ansvar.&lt;br&gt;&lt;b&gt;CIDOC CRM&lt;/b&gt;: semantiska begrepp och relationer.&lt;br&gt;&lt;b&gt;LIDO / Dublin Core&lt;/b&gt;: informationsutbyte.&lt;br&gt;&lt;b&gt;OAIS&lt;/b&gt;: referensmodell med SIP, AIP och DIP.&lt;br&gt;&lt;b&gt;Primus / RODA&lt;/b&gt;: system, inte standarder." tooltip="Process ≠ modell ≠ format ≠ system | &lt;b&gt;Spectrum&lt;/b&gt;: arbetsprocess och ansvar. | &lt;b&gt;CIDOC CRM&lt;/b&gt;: semantiska begrepp och relationer. | &lt;b&gt;LIDO / Dublin Core&lt;/b&gt;: informationsutbyte. | &lt;b&gt;OAIS&lt;/b&gt;: referensmodell med SIP, AIP och DIP. | &lt;b&gt;Primus / RODA&lt;/b&gt;: system, inte standarder.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="180" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note1" label="&lt;b&gt;Tre ansvarsnivåer&lt;/b&gt;&lt;br&gt;&lt;b&gt;Blått – museet:&lt;/b&gt; innehåll, rättigheter och verksamhetsbeslut.&lt;br&gt;&lt;b&gt;Lila – informationsförvaltning:&lt;/b&gt; modeller, fält, profiler och mappning.&lt;br&gt;&lt;b&gt;Turkost – IT/KSD:&lt;/b&gt; drift, lagring och tekniska kontroller." tooltip="Tre ansvarsnivåer | &lt;b&gt;Blått – museet:&lt;/b&gt; innehåll, rättigheter och verksamhetsbeslut. | &lt;b&gt;Lila – informationsförvaltning:&lt;/b&gt; modeller, fält, profiler och mappning. | &lt;b&gt;Turkost – IT/KSD:&lt;/b&gt; drift, lagring och tekniska kontroller.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="410" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note2" label="&lt;b&gt;Så läses beslut och återgångar&lt;/b&gt;&lt;br&gt;&lt;b&gt;Gul romb:&lt;/b&gt; kontrollgrind; följ svaret på pilen.&lt;br&gt;&lt;b&gt;Röd sidogren:&lt;/b&gt; avvikelse eller åtgärdsgren.&lt;br&gt;En återgång med steg-ID är en uttrycklig fortsättning, inte en avslutad process.&lt;br&gt;Klickbara sidhänvisningar öppnar detaljsidor." tooltip="Så läses beslut och återgångar | &lt;b&gt;Gul romb:&lt;/b&gt; kontrollgrind; följ svaret på pilen. | &lt;b&gt;Röd sidogren:&lt;/b&gt; avvikelse eller åtgärdsgren. | En återgång med steg-ID är en uttrycklig fortsättning, inte en avslutad process. | Klickbara sidhänvisningar öppnar detaljsidor.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="640" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
        <object id="note3" label="&lt;b&gt;Viktiga gränser&lt;/b&gt;&lt;br&gt;Bevaranderätt är inte publiceringsrätt.&lt;br&gt;Backup är inte ett AIP eller en aktiv bevarandeprocess.&lt;br&gt;DIP är inte samma sak som webbpublicering.&lt;br&gt;Originalet skrivs inte över av bearbetning eller export." tooltip="Viktiga gränser | Bevaranderätt är inte publiceringsrätt. | Backup är inte ett AIP eller en aktiv bevarandeprocess. | DIP är inte samma sak som webbpublicering. | Originalet skrivs inte över av bearbetning eller export.">
          <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#C2410C;fontColor=#0F172A;fontFamily=Helvetica;fontSize=17;spacing=12;strokeWidth=1.5;align=left;verticalAlign=middle;">
            <mxGeometry x="1040" y="870" width="700" height="190" as="geometry" />
          </mxCell>
        </object>
      </root>
    </mxGraphModel>
  </diagram>
